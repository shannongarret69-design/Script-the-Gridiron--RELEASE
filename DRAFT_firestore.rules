rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Entity Validation Helpers
    function isValidCard(data) {
      return data.keys().hasAll(['playerId', 'acquiredAt']) &&
             data.keys().hasOnly(['playerId', 'acquiredAt']) &&
             data.playerId is string && data.playerId.size() <= 128 &&
             data.acquiredAt is timestamp;
    }

    function isValidSquad(data) {
      return data.keys().hasAll(['name', 'playerIds']) &&
             data.keys().hasOnly(['name', 'playerIds']) &&
             data.name is string && data.name.size() <= 64 &&
             data.playerIds is list && data.playerIds.size() <= 11;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Players (Master list)
    match /players/{playerId} {
      allow read: if isSignedIn();
      allow write: if false; // System only
    }

    // Users
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User Cards
      match /cards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(cardId) && isValidCard(incoming());
        allow update, delete: if false; // Cards are immutable
      }

      // User Squads
      match /squads/{squadId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(squadId) && isValidSquad(incoming());
      }
    }
  }
}
